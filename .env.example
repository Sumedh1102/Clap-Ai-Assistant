# CLAP configuration.
#
# Copy to .env.local (npm run setup does this) and uncomment what you change.
# Every setting is optional: the values shown are the defaults.
# Real environment variables override this file.
#
# Bridge settings are read and validated by bridge/config.ts; a bad value stops
# the bridge with a message naming the variable (npm run doctor shows them all).
# Only VITE_CLAP_* settings reach the browser, and none of them may be secret.

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------

# CLAP runs Claude Code through the Agent SDK. Log in once with Claude Code
# (npm run doctor prints the exact command), or set an API key here.
# ANTHROPIC_API_KEY=

# CLAP_MODEL=claude-opus-5
# low | medium | high | xhigh | max
# CLAP_EFFORT=medium
# Most tool-using steps one request may take.
# CLAP_MAX_TURNS=20
# Built-in web search (runs on Anthropic's side; queries leave this machine).
# CLAP_ENABLE_WEB_SEARCH=1
# Keep Claude Code's session transcripts on disk.
# CLAP_PERSIST_SESSIONS=0
# How long a conversation survives a page reload or dropped connection.
# CLAP_SESSION_GRACE_S=120

# ---------------------------------------------------------------------------
# Wake phrase and permissions
# ---------------------------------------------------------------------------

# Two to five words of letters. A single word wakes CLAP by accident.
# CLAP_WAKE_PHRASE=hey clap

# What happens to MEDIUM-risk actions: allow | confirm | deny
# CLAP_POLICY_MEDIUM=allow
# HIGH-risk actions always need confirmation: confirm | deny (never allow)
# CLAP_POLICY_HIGH=confirm
# Seconds to wait for a yes or no before declining.
# CLAP_CONFIRM_TIMEOUT_S=45

# ---------------------------------------------------------------------------
# Voice (optional)
# ---------------------------------------------------------------------------

# Without a key CLAP uses the browser's own voice and recognition. The key stays
# in the bridge and is never sent to the browser. See docs/voice.md.
# ELEVENLABS_API_KEY=
# CLAP's voice (Dominic). `npm run voice:find -- dominic --use 1` sets this;
# a stock ElevenLabs voice is used until it is set.
# CLAP_VOICE_ID=
# auto | elevenlabs | none
# CLAP_TTS_PROVIDER=auto
# CLAP_STT_PROVIDER=auto
# CLAP_TTS_MODEL=eleven_flash_v2_5
# CLAP_STT_MODEL=scribe_v1
# CLAP_TTS_OUTPUT_FORMAT=mp3_44100_128
# Voice tuning; unset means the voice's own settings. Stability and similarity
# are 0–1, speed 0.7–1.2.
# CLAP_VOICE_STABILITY=
# CLAP_VOICE_SIMILARITY=
# CLAP_VOICE_SPEED=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# CLAP_BRIDGE_HOST=127.0.0.1
# CLAP_BRIDGE_PORT=7719
# The HUD's port. The bridge trusts exactly this origin, so Vite will not
# silently move to another port if it is taken.
# CLAP_UI_PORT=5173
# Extra origins allowed to use the bridge, comma-separated (e.g. a production
# build served elsewhere): http://localhost:4173
# CLAP_ALLOWED_ORIGINS=
# Binding anything but loopback exposes tools on this machine to the network.
# CLAP_ALLOW_NON_LOOPBACK=0
# Accept WebSocket clients that send no Origin (scripts). Off: local malware
# could otherwise drive CLAP.
# CLAP_ALLOW_NO_ORIGIN=0

# ---------------------------------------------------------------------------
# Running and debugging
# ---------------------------------------------------------------------------

# npm start opens the browser unless this is 0.
# CLAP_OPEN_BROWSER=1
# pretty | json | auto (pretty on a terminal, JSON when piped)
# CLAP_LOG_FORMAT=auto
# Debug logs, including Claude Code's stderr, and error stacks.
# CLAP_DEBUG=0
# Reserved for long-term memory (Phase 5). Defaults to .clap in your home folder.
# CLAP_DATA_DIR=

# ---------------------------------------------------------------------------
# HUD (browser; never put secrets here)
# ---------------------------------------------------------------------------

# Defaults to http://127.0.0.1:$CLAP_BRIDGE_PORT.
# VITE_CLAP_BRIDGE_URL=
# Recognition language; defaults to the browser's.
# VITE_CLAP_LANG=en-US
# Wake engine: auto | local | cloud | push-to-talk
# VITE_CLAP_WAKE_ENGINE=auto
# May the browser's cloud recogniser listen for the wake phrase when on-device
# recognition is unavailable?
# VITE_CLAP_WAKE_ALLOW_CLOUD=1
# Speech to text and text to speech: auto | browser | cloud
# VITE_CLAP_STT=auto
# VITE_CLAP_TTS=auto
# Log every protocol frame in the browser console.
# VITE_CLAP_DEBUG=0
